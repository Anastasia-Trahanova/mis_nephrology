# Скопируйте в pilot_credentials.env только если хотите задать свой пароль.
# Файл pilot_credentials.env не попадёт в Git и в публичный установочный код.
# Если файл не создать, сборщик сам сгенерирует временный пароль и сохранит его локально.

PILOT_SHARED_PASSWORD=замените_на_временный_пароль_не_короче_8_символов

# Необязательные индивидуальные пароли. Если строка отсутствует,
# используется PILOT_SHARED_PASSWORD.
# PASSWORD_ADMIN26_08=
# PASSWORD_ZAKHAROVA_M=
# PASSWORD_KAZARKIN_D=
# PASSWORD_VOZOVA_A=
# PASSWORD_LOBANOVA_N=
# PASSWORD_KUZNETSOVA_T=
# PASSWORD_REGISTRAR=
